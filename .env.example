# TikTok Auto-Posting Machine — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to git!
# =============================================================================

# --- TikTok account ---------------------------------------------------------
# Cookie/session profile name used by TiktokAutoUploader.
# Default: "kumpul.shop"
TIKTOK_SESSION_USERNAME=kumpul.shop

# Absolute path to the TiktokAutoUploader checkout (contains config.txt and CookiesDir/).
# Default: "/home/archery/ai-project/tiktokflows_arena.AI/TiktokAutoUploader"
TIKTOK_UPLOADER_DIR=/home/archery/ai-project/tiktokflows_arena.AI/TiktokAutoUploader

# Warn when cookies are older than this many days.
# Default: 14
TIKTOK_COOKIE_MAX_AGE_DAYS=14

# --- Residential proxy (anti-shadowban) --------------------------------------
# A VPS has a datacenter IP; TikTok quietly shadowbans uploads from datacenter
# ranges ("posted but 0 views"). Point this at a *Malaysian residential or
# 4G/mobile* proxy. ONLY the TikTok upload is routed through it (passed
# per-call, never via global HTTP(S)_PROXY), so Apify/Telegram/Drive/AI
# traffic does not consume proxy GB.
#
# Accepts canonical AND shorthand formats:
#   http://user:pass@host:port
#   user:pass@host:port
#   user:pass:host:port          <- your vendor's common format
#   host:port:user:pass          <- alternate vendor order
#   host:port
#
# Required if using a proxy for uploads.
TIKTOK_PROXY=

# Strict mode: abort the run when the exit IP is verified non-MY or
# datacenter-class (recommended on metered plans).
# Default: true
TIKTOK_PROXY_STRICT=true

# Geo check: ~2KB pre-upload exit-IP check (ip-api.com + ipinfo.io
# fallback) so a dead/wrong-country proxy never burns a full metered upload.
# Default: true
TIKTOK_PROXY_GEO_CHECK=true

# Expected country code for proxy geo-check.
# Default: MY
TIKTOK_PROXY_EXPECTED_COUNTRY=MY

# Verify endpoint for proxy geo-check.
# Default: https://ipinfo.io/json
TIKTOK_PROXY_VERIFY_ENDPOINT=https://ipinfo.io/json

# --- AI (capped, cached) -----------------------------------------------------
# OpenAI-compatible API key for AI caption generation.
# Required if ai.enable_ai is true.
OPENAI_API_KEY=

# Base URL for OpenAI-compatible API.
# Default: https://api.iamhc.cn/v1
OPENAI_BASE_URL=https://api.iamhc.cn/v1

# Model to use for AI calls.
# Default: auto
OPENAI_MODEL=auto

# Enable/disable all AI calls globally.
# Default: true
ENABLE_AI=true

# Maximum AI calls per calendar day (business timezone).
# Default: 1
MAX_AI_CALLS_PER_DAY=1

# --- Apify competitor scraping -----------------------------------------------
# Apify API token for competitor scraping.
# Required if apify.token is not set in config.yaml.
APIFY_TOKEN=

# --- Telegram ----------------------------------------------------------------
# Telegram bot token for notifications.
# Required if telegram.bot_token is not set in config.yaml.
TELEGRAM_BOT_TOKEN=

# Telegram chat ID for notifications.
# Required if telegram.chat_id is not set in config.yaml.
TELEGRAM_CHAT_ID=

# --- Database / Logging ------------------------------------------------------
# Path to SQLite database file.
# Default: logs/tiktok.db
TIKTOK_DB_PATH=logs/tiktok.db

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# Default: INFO
LOG_LEVEL=INFO

# Log file path (optional, logs to console if not set).
# Default: None (console only)
LOG_FILE=

# --- Timezone ----------------------------------------------------------------
# Business timezone (MYT, UTC+8).
# Default: Asia/Kuala_Lumpur
TZ=Asia/Kuala_Lumpur

# --- TikTok login proxy (for qr_login.py) ------------------------------------
# Proxy to use during QR login. Should match TIKTOK_PROXY for IP consistency.
# Default: same as TIKTOK_PROXY
TIKTOK_LOGIN_PROXY=

# --- TikTok uploader directory (for scripts) ---------------------------------
# TiktokAutoUploader installation directory.
# Default: /home/archery/ai-project/tiktokflows_arena.AI/TiktokAutoUploader
TIKTOK_UPLOADER_DIR=/home/archery/ai-project/tiktokflows_arena.AI/TiktokAutoUploader

# --- Testing mode ------------------------------------------------------------
# Set to "1" to enable test mode (isolated environment, mocked services).
# Default: 0
TESTING=0

# --- Configuration file path -------------------------------------------------
# Path to the main config.yaml file.
# Default: config/config.yaml
TIKTOK_MACHINE_CONFIG=config/config.yaml